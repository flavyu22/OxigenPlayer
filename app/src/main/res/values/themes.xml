<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Named Base.Theme.* (not Theme.*.Base) so implicit dot-parent lookup can
         never form a cycle with Theme.OxigenPlayer. -->
    <style name="Base.Theme.OxigenPlayer" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorPrimary">@color/primary</item>
        <item name="android:colorAccent">@color/secondary</item>
        <item name="android:windowBackground">@color/background_dark</item>
        <item name="android:statusBarColor">@color/background_dark</item>
        <item name="android:navigationBarColor">@color/background_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- Disable window animations for instant opening -->
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <style name="Theme.OxigenPlayer" parent="@style/Base.Theme.OxigenPlayer" />

    <!-- Launch theme: shows the branded splash (gradient + Oxigen logo) as the window
         background while the activity inflates its first frame. MainActivity switches back
         to Theme.OxigenPlayer in onCreate so the steady-state UI is unaffected. -->
    <style name="Theme.OxigenPlayer.Splash" parent="@style/Base.Theme.OxigenPlayer">
        <item name="android:windowBackground">@drawable/splash_window</item>
    </style>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <!-- Android Network Security Config cannot express RFC1918 address ranges or arbitrary
         user-selected LAN hostnames. The app therefore enables cleartext at the
         platform gate, while PlaybackUriPolicy and both OkHttp application/network interceptors
         restrict HTTP to explicit LAN targets and verify the connected route address. -->
    <base-config cleartextTrafficPermitted="true" tools:ignore="InsecureBaseConfiguration">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>

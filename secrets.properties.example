# Optional public-client provider values. Copy this file to
# ~/.gradle/oxigenplayer-secrets.properties or point OXIGEN_SECRETS_FILE to it.
# Values are embedded only in local debug builds when
# OXIGEN_EMBED_PROVIDER_CREDENTIALS=true. Release builds always use empty values.
# Never place privileged/server credentials in an APK.
OS_API_KEY=
SUBS_RO_API_KEY=
SUBDL_API_KEY=
TMDB_API_KEY=
DEEPL_AUTH_KEY=
